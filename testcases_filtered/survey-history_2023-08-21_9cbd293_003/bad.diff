+################################################################################
+func to_text() -> String:
+	return "return"
+
+
+func from_text(string:String) -> void:
+	pass
+
+
+func is_valid_event(string:String) -> bool:
+	if string.strip_edges() == "return":
+		return true
+	return false
+
+
+################################################################################
