+# --- generation -------------------------------------------------------------
+
+func _on_generate_pressed() -> void:
+	if llm.busy:
+		status_label.text = "已有大模型请求正在进行，请稍候。"
+		return
+	if _video_path.is_empty() or not FileAccess.file_exists(_video_path):
+		status_label.text = "请先拖入或选择一个视频文件。"
+		return
+	var ffmpeg: String = FfmpegUtil.resolve()
+	if ffmpeg.is_empty():
+		status_label.text = "未找到 ffmpeg。请在 user://ffmpeg_config.json 中配置 ffmpeg_path。"
+		return
+	if not llm.is_configured():
+		status_label.text = "请先配置访问令牌 (Token)。"
+		_pending_generate = true
+		if _token_prompt != null:
+			_token_prompt.popup()
+		return
+
+	# Sample frames (blocking; small N, fast seeks).
+	var out_dir: String = ProjectSettings.globalize_path(FRAMES_DIR.path_join("sample"))
+	var src_abs: String = ProjectSettings.globalize_path(_video_path) if _video_path.begins_with("user://") else _video_path
+	var frames: PackedStringArray = FfmpegUtil.sample_frames(ffmpeg, src_abs, out_dir, int(frame_count_spin.value), _video_duration, 512)
+	if frames.is_empty():
+		status_label.text = "抽帧失败（检查 ffmpeg 与视频文件）。"
+		return
+
+	var model_entry: Dictionary = _selected_model()
+	var model_id: String = str(model_entry.get("model", ""))
+	llm.model_override = model_id
+	llm.protocol_override = str(model_entry.get("protocol", ""))
+
+	var system_prompt: String = system_prompt_edit.text.strip_edges()
+	if system_prompt.is_empty():
+		system_prompt = SYSTEM_PROMPT
+	if not system_prompt.contains("\"shots\""):
+		system_prompt += FORMAT_REMINDER
+
+	var user_prompt: String = "以下是这段参考视频按时间顺序抽取的 %d 张关键帧。目标成片总时长约 %d 秒。" % [frames.size(), int(duration_spin.value)]
+	var plot_note: String = plot_edit.text.strip_edges()
+	if not plot_note.is_empty():
+		user_prompt += "\n补充背景/意图：%s" % plot_note
+	user_prompt += "\n请据此产出有表现力的分镜脚本（严格遵守系统 Prompt 的 JSON 格式）。"
+
+	_set_controls_disabled(true)
+	status_label.text = "%s 生成中…（已抽 %d 帧）" % [str(model_entry.get("label", model_id)), frames.size()]
+	var started: bool = llm.complete_with_images(user_prompt, frames, system_prompt, 4096)
+	if not started:
+		_set_controls_disabled(false)
+
+
+func _on_token_saved() -> void:
+	if _pending_generate:
+		_pending_generate = false
+		_on_generate_pressed()
+
+
+func _on_llm_completed(text: String, _envelope: Dictionary) -> void:
+	_set_controls_disabled(false)
+	var sb: Dictionary = _extract_storyboard(text)
+	if sb.is_empty():
+		Log.warn("videoScriptGen", "生成结果未解析出分镜 JSON，作为单条分镜回退", { "reply_len": text.length() })
+		_load_storyboard({ "scene": {}, "shots": [{ "period": "全片", "script": text, "duration": int(duration_spin.value) }] })
+		status_label.text = "未能解析为分镜结构，已作为单条分镜载入，请手动整理。"
+		return
+	_load_storyboard(sb)
+	var shot_count: int = (sb.get("shots", []) as Array).size() if typeof(sb.get("shots", [])) == TYPE_ARRAY else 0
+	status_label.text = "分镜脚本已生成（%d 个分镜），可编辑/重命名后保存。" % shot_count
+
+
+func _on_llm_failed(message: String, _envelope: Dictionary) -> void:
+	_set_controls_disabled(false)
+	status_label.text = "生成失败：%s" % message
+
+
+func _set_controls_disabled(disabled: bool) -> void:
+	if generate_btn != null:
+		generate_btn.disabled = disabled
+
+
+# Extracts a storyboard object from a fenced ```json block or raw JSON (mirrors scriptGen).
+func _extract_storyboard(text: String) -> Dictionary:
+	var body: String = text
+	var fence: int = text.find("```")
+	if fence >= 0:
+		var start: int = text.find("\n", fence)
+		var end: int = text.rfind("```")
+		if start >= 0 and end > start:
+			body = text.substr(start + 1, end - start - 1)
+	body = body.strip_edges()
+	if body.begins_with("json"):
+		body = body.substr(4).strip_edges()
+	var parsed: Variant = JSON.parse_string(body)
+	return parsed if typeof(parsed) == TYPE_DICTIONARY else {}
+
+
