+	scol.add_theme_constant_override("separation", 5)
+	box.add_child(scol)
+
+	var head := HBoxContainer.new()
+	head.add_theme_constant_override("separation", 6)
+	scol.add_child(head)
+	var idx_label := Label.new()
+	idx_label.custom_minimum_size = Vector2(56, 0)
+	idx_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
+	head.add_child(idx_label)
+	var period := LineEdit.new()
+	period.placeholder_text = "时段（如：0-3s / 开场）"
+	period.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	period.text = str(values.get("period", ""))
+	head.add_child(period)
+	var dur_cap := Label.new()
+	dur_cap.text = "时长"
+	dur_cap.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
+	head.add_child(dur_cap)
+	var duration := SpinBox.new()
+	duration.min_value = 1
+	duration.max_value = 15
+	duration.step = 1
+	duration.value = clampf(float(values.get("duration", 3)), 1, 15)
+	head.add_child(duration)
+	var remove := Button.new()
+	remove.text = "删除"
+	head.add_child(remove)
+
+	var purpose := LineEdit.new()
+	purpose.placeholder_text = "演出目的（这一镜想表达什么）"
+	purpose.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	purpose.text = str(values.get("purpose", ""))
+	scol.add_child(purpose)
+
+	var description := TextEdit.new()
+	description.placeholder_text = "分镜描述（镜头 / 构图 / 表演）"
+	description.wrap_mode = TextEdit.LINE_WRAPPING_BOUNDARY
+	description.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	description.custom_minimum_size = Vector2(0, 52)
+	description.text = str(values.get("description", ""))
+	scol.add_child(description)
+
+	var script_edit := TextEdit.new()
+	script_edit.placeholder_text = "脚本（台词 / 旁白）"
+	script_edit.wrap_mode = TextEdit.LINE_WRAPPING_BOUNDARY
+	script_edit.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	script_edit.custom_minimum_size = Vector2(0, 52)
+	script_edit.text = str(values.get("script", ""))
+	scol.add_child(script_edit)
+
+	var entry := {
+		"period": period, "purpose": purpose, "description": description,
+		"script": script_edit, "duration": duration, "box": box, "idx_label": idx_label,
+	}
+	_shot_rows.append(entry)
+	remove.pressed.connect(_on_remove_shot.bind(entry))
+	_renumber_shots()
+
+
+func _on_remove_shot(entry: Dictionary) -> void:
+	_shot_rows.erase(entry)
+	if is_instance_valid(entry.get("box")):
+		entry["box"].queue_free()
+	_renumber_shots()
+
+
+func _renumber_shots() -> void:
+	for i in _shot_rows.size():
+		if is_instance_valid(_shot_rows[i].get("idx_label")):
+			_shot_rows[i]["idx_label"].text = "第%d镜" % (i + 1)
+
+
+func _collect_storyboard() -> Dictionary:
+	var shots: Array = []
+	for e in _shot_rows:
+		var period: String = e["period"].text.strip_edges()
+		var purpose: String = e["purpose"].text.strip_edges()
+		var description: String = e["description"].text.strip_edges()
+		var script_text: String = e["script"].text.strip_edges()
+		if period.is_empty() and purpose.is_empty() and description.is_empty() and script_text.is_empty():
+			continue
+		shots.append({
+			"period": period, "purpose": purpose, "description": description,
+			"script": script_text, "duration": int(e["duration"].value),
+		})
+	return {
+		"scene": {
+			"time": scene_time_edit.text.strip_edges(),
+			"place": scene_place_edit.text.strip_edges(),
+			"background": scene_background_edit.text.strip_edges(),
+		},
+		"shots": shots,
+	}
+
+
+func _load_storyboard(sb: Dictionary) -> void:
+	var scene: Dictionary = sb.get("scene", {}) if typeof(sb.get("scene", {})) == TYPE_DICTIONARY else {}
+	if scene_time_edit != null:
+		scene_time_edit.text = str(scene.get("time", ""))
+		scene_place_edit.text = str(scene.get("place", ""))
+		scene_background_edit.text = str(scene.get("background", ""))
+	for e in _shot_rows:
+		if is_instance_valid(e.get("box")):
+			e["box"].queue_free()
+	_shot_rows.clear()
+	var shots: Array = sb.get("shots", []) if typeof(sb.get("shots", [])) == TYPE_ARRAY else []
+	for s in shots:
+		if typeof(s) == TYPE_DICTIONARY:
+			_add_shot_row(s)
+
+
+func _storyboard_duration() -> int:
+	var total: int = 0
+	for e in _shot_rows:
+		total += int(e["duration"].value)
+	return total if total > 0 else int(duration_spin.value)
+
+
+func _render_storyboard_text(sb: Dictionary) -> String:
+	if typeof(sb) != TYPE_DICTIONARY or sb.is_empty():
+		return ""
+	var lines: Array = []
+	var scene: Dictionary = sb.get("scene", {}) if typeof(sb.get("scene", {})) == TYPE_DICTIONARY else {}
+	var scene_bits: Array = []
+	if not str(scene.get("time", "")).strip_edges().is_empty():
+		scene_bits.append("时间：" + str(scene.get("time", "")).strip_edges())
+	if not str(scene.get("place", "")).strip_edges().is_empty():
+		scene_bits.append("地点：" + str(scene.get("place", "")).strip_edges())
+	if not str(scene.get("background", "")).strip_edges().is_empty():
+		scene_bits.append("背景：" + str(scene.get("background", "")).strip_edges())
+	if not scene_bits.is_empty():
+		lines.append("【场景设定】")
+		lines.append_array(scene_bits)
+	var shots: Array = sb.get("shots", []) if typeof(sb.get("shots", [])) == TYPE_ARRAY else []
+	for i in shots.size():
+		var s: Dictionary = shots[i] if typeof(shots[i]) == TYPE_DICTIONARY else {}
+		if not lines.is_empty():
+			lines.append("")
+		var head: String = "【第%d镜" % (i + 1)
+		if not str(s.get("period", "")).strip_edges().is_empty():
+			head += " · %s" % str(s.get("period", "")).strip_edges()
+		head += " · %ds】" % int(s.get("duration", 0))
+		lines.append(head)
+		if not str(s.get("purpose", "")).strip_edges().is_empty():
+			lines.append("目的：" + str(s.get("purpose", "")).strip_edges())
+		if not str(s.get("description", "")).strip_edges().is_empty():
+			lines.append(str(s.get("description", "")).strip_edges())
+		if not str(s.get("script", "")).strip_edges().is_empty():
+			lines.append("台词：" + str(s.get("script", "")).strip_edges())
+	return "\n".join(PackedStringArray(lines))
+
+
+# --- library save / load ----------------------------------------------------
+
+func _selected_model() -> Dictionary:
+	var idx: int = model_option.selected if model_option != null else -1
+	if idx >= 0 and idx < _script_models.size():
+		return _script_models[idx]
+	return {}
+
+
+func _script_name() -> String:
+	var n: String = name_edit.text.strip_edges() if name_edit != null else ""
+	if not n.is_empty():
+		return n
+	if not _video_path.is_empty():
+		return _video_path.get_file().get_basename()
+	return "视频脚本"
+
+
+func _collect_payload() -> Dictionary:
+	var model_entry: Dictionary = _selected_model()
+	var storyboard: Dictionary = _collect_storyboard()
+	var plot: String = plot_edit.text.strip_edges()
+	if plot.is_empty() and not _video_path.is_empty():
+		plot = "由视频反推：%s" % _video_path.get_file()
+	return {
+		"name": _script_name(),
+		"meta": {
+			"title": _script_name(),
+			"plot": plot,
+			"duration": _storyboard_duration(),
+			"system_prompt": system_prompt_edit.text.strip_edges(),
+			"prompt": "",
+			"storyboard": storyboard,
+			"script": _render_storyboard_text(storyboard),
+			"characters": [],
+			"source_video": _video_path.get_file(),
+			"model": {
+				"label": str(model_entry.get("label", "")),
+				"model": str(model_entry.get("model", "")),
+				"backend": str(model_entry.get("backend", "")),
+			},
+		},
+		"image_bytes": PackedByteArray(),
+	}
+
+
+func _on_save_pressed() -> void:
+	var storyboard: Dictionary = _collect_storyboard()
+	if (storyboard.get("shots", []) as Array).is_empty():
+		status_label.text = "没有可保存的分镜，请先生成或手动添加分镜。"
+		return
+	var lib: String = library_panel.current_library() if library_panel != null else ""
+	var payload: Dictionary = _collect_payload()
+	var rec: Dictionary = LibraryStoreScript.save_item(lib, "script", payload.get("meta", {}), PackedByteArray(), _script_name())
+	if library_panel != null:
+		library_panel.refresh()
+	if rec.is_empty():
+		status_label.text = "保存失败。"
+	else:
+		status_label.text = "已保存脚本「%s」到素材库，可在第③步读入。" % _script_name()
+
+
+func _on_library_item_selected(rec: Dictionary) -> void:
+	var meta: Dictionary = rec.get("meta", {}) if typeof(rec.get("meta", {})) == TYPE_DICTIONARY else {}
+	if name_edit != null:
+		name_edit.text = LibraryStoreScript.display_name(rec)
+	if plot_edit != null:
+		plot_edit.text = str(meta.get("plot", ""))
+	if system_prompt_edit != null and not str(meta.get("system_prompt", "")).is_empty():
+		system_prompt_edit.text = str(meta.get("system_prompt", ""))
+	if duration_spin != null and meta.has("duration"):
+		duration_spin.value = clampf(float(meta.get("duration", 15)), duration_spin.min_value, duration_spin.max_value)
+	if meta.has("storyboard") and typeof(meta["storyboard"]) == TYPE_DICTIONARY:
+		_load_storyboard(meta["storyboard"])
+	elif not str(meta.get("script", "")).strip_edges().is_empty():
+		_load_storyboard({ "scene": {}, "shots": [{ "period": "全片", "script": str(meta.get("script", "")), "duration": int(meta.get("duration", 5)) }] })
+	status_label.text = "已载入脚本：%s（可编辑后另存）" % LibraryStoreScript.display_name(rec)
+
+
