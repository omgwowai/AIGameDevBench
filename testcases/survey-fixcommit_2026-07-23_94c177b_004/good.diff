+	row.add_child(top)
+	var code := LineEdit.new()
+	code.placeholder_text = "编号(01A)"
+	code.custom_minimum_size = Vector2(74, 0)
+	code.text = str(values.get("code", ""))
+	code.text_changed.connect(func(_t): changed.emit())
+	top.add_child(code)
+	var period := LineEdit.new()
+	period.placeholder_text = "时间轴(0:00-0:02)"
+	period.custom_minimum_size = Vector2(120, 0)
+	period.text = str(values.get("period", ""))
+	period.text_changed.connect(func(_t): changed.emit())
+	top.add_child(period)
+	var camera := LineEdit.new()
+	camera.placeholder_text = "机位(45度正打A)"
+	camera.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	camera.text = str(values.get("camera", ""))
+	camera.text_changed.connect(func(_t): changed.emit())
+	top.add_child(camera)
+	var camera_move := LineEdit.new()
+	camera_move.placeholder_text = "运动(固定/zoom in)"
+	camera_move.custom_minimum_size = Vector2(120, 0)
+	camera_move.text = str(values.get("camera_move", ""))
+	camera_move.text_changed.connect(func(_t): changed.emit())
+	top.add_child(camera_move)
+	var rem := Button.new()
+	rem.text = "×"
+	top.add_child(rem)
+
+	var script_edit := LineEdit.new()
+	script_edit.placeholder_text = "台词/动作（沿用 @角色N，注明语气）"
+	script_edit.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	script_edit.text = str(values.get("script", ""))
+	script_edit.text_changed.connect(func(_t): changed.emit())
+	row.add_child(script_edit)
+
+	var sub := { "code": code, "period": period, "camera": camera, "camera_move": camera_move, "script": script_edit, "row": row }
+	shot["subs"].append(sub)
+	rem.pressed.connect(func():
+		shot["subs"].erase(sub)
+		if is_instance_valid(row):
+			row.queue_free()
+		changed.emit())
+
+
+func _on_remove_shot(entry: Dictionary) -> void:
+	_shot_rows.erase(entry)
+	if is_instance_valid(entry.get("box")):
+		entry["box"].queue_free()
+	_renumber_shots()
+	changed.emit()
+
+
+func _renumber_shots() -> void:
+	for i in _shot_rows.size():
+		if is_instance_valid(_shot_rows[i].get("idx_label")):
+			_shot_rows[i]["idx_label"].text = "镜头%d" % (i + 1)
+
+
+# --- collect / load / render ------------------------------------------------
+
+func collect_storyboard() -> Dictionary:
+	var shots: Array = []
+	for e in _shot_rows:
+		var shot: Dictionary = { "duration": int(e["duration"].value) }
+		var any: bool = false
+		for pair in MAIN_SHOT_FIELDS:
+			var key: String = pair[0]
+			var val: String = str(e["fields"][key].text).strip_edges()
+			shot[key] = val
+			if not val.is_empty():
+				any = true
+		var subshots: Array = []
+		for s in e["subs"]:
+			var sub: Dictionary = {
+				"code": s["code"].text.strip_edges(),
+				"period": s["period"].text.strip_edges(),
+				"camera": s["camera"].text.strip_edges(),
+				"camera_move": s["camera_move"].text.strip_edges(),
+				"script": s["script"].text.strip_edges(),
+			}
+			if sub.values().any(func(v): return not str(v).is_empty()):
+				subshots.append(sub)
+				any = true
+		if not any:
+			continue
+		shot["subshots"] = subshots
+		shots.append(shot)
+	return {
+		"scene": {
+			"time": scene_time_edit.text.strip_edges(),
+			"place": scene_place_edit.text.strip_edges(),
+			"background": scene_background_edit.text.strip_edges(),
+		},
+		"characters": scene_characters_edit.text.strip_edges(),
+		"shots": shots,
+	}
+
+
+func load_storyboard(sb: Dictionary) -> void:
+	var scene: Dictionary = sb.get("scene", {}) if typeof(sb.get("scene", {})) == TYPE_DICTIONARY else {}
+	scene_time_edit.text = str(scene.get("time", ""))
+	scene_place_edit.text = str(scene.get("place", ""))
+	scene_background_edit.text = str(scene.get("background", ""))
+	scene_characters_edit.text = str(sb.get("characters", ""))
+	for e in _shot_rows:
+		if is_instance_valid(e.get("box")):
+			e["box"].queue_free()
+	_shot_rows.clear()
+	var shots: Array = sb.get("shots", []) if typeof(sb.get("shots", [])) == TYPE_ARRAY else []
+	for s in shots:
+		if typeof(s) == TYPE_DICTIONARY:
+			_add_shot_row(_normalize_shot(s))
+
+
+func shot_count() -> int:
+	return _shot_rows.size()
+
+
+# Enables/disables all editable controls in the widget (used while a task is running).
+func set_disabled(disabled: bool) -> void:
+	for node in find_children("*", "LineEdit", true, false):
+		node.editable = not disabled
+	for node in find_children("*", "TextEdit", true, false):
+		node.editable = not disabled
+	for node in find_children("*", "SpinBox", true, false):
+		node.editable = not disabled
+	for node in find_children("*", "Button", true, false):
+		node.disabled = disabled
+
+
+func storyboard_duration(fallback: int = 5) -> int:
+	var total: int = 0
+	for e in _shot_rows:
+		total += int(e["duration"].value)
+	return total if total > 0 else fallback
+
+
+# Normalizes a legacy flat shot {period,purpose,description,script,duration} to the two-level
+# shape. New-shape shots pass through unchanged.
+func _normalize_shot(s: Dictionary) -> Dictionary:
+	if s.has("subshots") or s.has("frame") or s.has("shot_size"):
+		return s
+	var out: Dictionary = {
+		"period": str(s.get("period", "")),
+		"frame": str(s.get("description", "")),
+		"intent": str(s.get("purpose", "")),
+		"duration": int(s.get("duration", 5)),
+	}
+	var legacy_script: String = str(s.get("script", "")).strip_edges()
+	if not legacy_script.is_empty():
+		out["subshots"] = [{ "code": "", "period": "", "camera": "", "camera_move": "", "script": legacy_script }]
+	return out
+
+
+# Renders a storyboard dict to human-readable text (for meta.script / the video prompt).
+static func render_text(sb: Dictionary) -> String:
+	if typeof(sb) != TYPE_DICTIONARY or sb.is_empty():
+		return ""
+	var lines: Array = []
+	var scene: Dictionary = sb.get("scene", {}) if typeof(sb.get("scene", {})) == TYPE_DICTIONARY else {}
+	var scene_bits: Array = []
+	if not str(scene.get("time", "")).strip_edges().is_empty():
+		scene_bits.append("时间：" + str(scene.get("time", "")).strip_edges())
+	if not str(scene.get("place", "")).strip_edges().is_empty():
+		scene_bits.append("地点：" + str(scene.get("place", "")).strip_edges())
+	if not str(scene.get("background", "")).strip_edges().is_empty():
+		scene_bits.append("背景：" + str(scene.get("background", "")).strip_edges())
+	if not scene_bits.is_empty():
+		lines.append("【场景设定】")
+		lines.append_array(scene_bits)
+	var chars: String = str(sb.get("characters", "")).strip_edges()
+	if not chars.is_empty():
+		lines.append("人物：" + chars)
+	var detail_labels := { "shot_size": "景别", "characters": "人物", "frame": "画面",
+		"emotion": "情绪", "sound": "声音", "lighting": "灯光", "art": "美术", "lens": "焦段", "intent": "导演意图" }
+	var shots: Array = sb.get("shots", []) if typeof(sb.get("shots", [])) == TYPE_ARRAY else []
+	for i in shots.size():
+		var s: Dictionary = shots[i] if typeof(shots[i]) == TYPE_DICTIONARY else {}
+		if not lines.is_empty():
+			lines.append("")
+		var head: String = "【镜头%d" % (i + 1)
+		if not str(s.get("period", "")).strip_edges().is_empty():
+			head += " · %s" % str(s.get("period", "")).strip_edges()
+		head += " · %ds】" % int(s.get("duration", 0))
+		lines.append(head)
+		for key in ["shot_size", "characters", "frame", "emotion", "sound", "lighting", "art", "lens", "intent"]:
+			var v: String = str(s.get(key, "")).strip_edges()
+			if not v.is_empty():
+				lines.append("%s：%s" % [detail_labels[key], v])
+		var subs: Array = s.get("subshots", []) if typeof(s.get("subshots", [])) == TYPE_ARRAY else []
+		for sub in subs:
+			if typeof(sub) != TYPE_DICTIONARY:
+				continue
+			var bits: Array = []
+			var code: String = str(sub.get("code", "")).strip_edges()
+			var sp: String = str(sub.get("period", "")).strip_edges()
+			var cam: String = str(sub.get("camera", "")).strip_edges()
+			var mov: String = str(sub.get("camera_move", "")).strip_edges()
+			if not code.is_empty() or not sp.is_empty():
+				bits.append("[%s %s]" % [code, sp])
+			if not cam.is_empty():
+				bits.append("机位:" + cam)
+			if not mov.is_empty():
+				bits.append("运动:" + mov)
+			var prefix: String = " ".join(bits)
+			var scr: String = str(sub.get("script", "")).strip_edges()
+			if not prefix.is_empty() or not scr.is_empty():
+				lines.append(("  " + prefix + (" " + scr if not scr.is_empty() else "")).strip_edges())
+	return "\n".join(lines)
+
+
+# --- helpers ----------------------------------------------------------------
+
+func _field_label(text: String) -> Label:
+	var l := Label.new()
+	l.text = text
+	l.custom_minimum_size = Vector2(72, 0)
+	l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
+	return l
+
+
+func _hspacer() -> Control:
+	var s := Control.new()
+	s.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	return s
