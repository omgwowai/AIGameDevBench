diff --git a/tests/video_task_editors_ui_test.gd b/tests/video_task_editors_ui_test.gd
new file mode 100644
index 0000000..96b3cee
--- /dev/null
+++ b/tests/video_task_editors_ui_test.gd
@@ -0,0 +1,71 @@
+extends Node
+
+const VideoTasksScreenScript := preload("res://scripts/screens/video_tasks_screen.gd")
+
+var _errors: Array[String] = []
+
+
+func _ready() -> void:
+	var screen = VideoTasksScreenScript.new()
+	get_tree().root.add_child.call_deferred(screen)
+	await get_tree().process_frame
+	await get_tree().process_frame
+	screen.call("_add_task_editor")
+	await get_tree().process_frame
+
+	var editor_one = screen.find_child("VideoTaskEditor_1", true, false)
+	var editor_two = screen.find_child("VideoTaskEditor_2", true, false)
+	_expect(editor_one != null and editor_two != null, "新增生产任务必须创建两个独立编辑器实例")
+	if editor_one != null and editor_two != null:
+		# Script is now edited as a structured storyboard (StoryboardEditor), not a flat TextEdit.
+		var script_one = editor_one.find_child("ScriptStoryboardEditor", true, false)
+		var script_two = editor_two.find_child("ScriptStoryboardEditor", true, false)
+		var setting_one = editor_one.find_child("VideoSettingPromptEdit", true, false)
+		var setting_two = editor_two.find_child("VideoSettingPromptEdit", true, false)
+		var provider_one = editor_one.find_child("ProviderOption", true, false)
+		var provider_two = editor_two.find_child("ProviderOption", true, false)
+		var script_select_one = editor_one.find_child("ScriptSelectionOption", true, false)
+		var script_select_two = editor_two.find_child("ScriptSelectionOption", true, false)
+		var models_one = editor_one.find_child("ModelSelectionSection", true, false)
+		var models_two = editor_two.find_child("ModelSelectionSection", true, false)
+
+		_expect(script_one != null and script_two != null and script_one != script_two, "每个任务必须拥有独立脚本分镜编辑器")
+		_expect(setting_one is TextEdit and setting_two is TextEdit and setting_one != setting_two, "每个任务必须拥有独立视频设定编辑框")
+		_expect(provider_one is OptionButton and provider_two is OptionButton and provider_one != provider_two, "每个任务必须拥有独立 Provider 选择")
+		_expect(script_select_one is OptionButton and script_select_two is OptionButton and script_select_one != script_select_two, "每个任务必须拥有独立脚本选择器")
+		_expect(models_one is VBoxContainer and models_two is VBoxContainer and models_one != models_two, "每个任务必须拥有独立模型选择区域")
+
+		if script_one != null and script_two != null:
+			editor_one.call("_set_script_single", "任务一脚本")
+			editor_two.call("_set_script_single", "任务二脚本")
+			var text_one: String = str(editor_one.call("_script_text"))
+			var text_two: String = str(editor_two.call("_script_text"))
+			_expect(text_one.contains("任务一脚本") and text_two.contains("任务二脚本"), "修改一个任务脚本不得覆盖另一个任务")
+		if setting_one is TextEdit and setting_two is TextEdit:
+			setting_one.text = "冷色夜景"
+			setting_two.text = "暖色白天"
+			_expect(setting_one.text != setting_two.text, "任务视频设定必须彼此隔离")
+		if provider_one is OptionButton and provider_two is OptionButton:
+			provider_two.selected = 1
+			editor_two.call("_on_provider_selected", 1)
+			_expect(provider_one.selected == 0 and provider_two.selected == 1, "切换一个任务 Provider 不得改变另一个任务")
+
+	var content_one = screen.find_child("ProductionTaskContent_1", true, false)
+	var status_one = screen.find_child("ProductionTaskStatus_1", true, false)
+	screen.call("_on_toggle_task", false, "production_task_1")
+	_expect(content_one is VBoxContainer and not content_one.visible, "完整生产任务 Tab 必须支持折叠")
+	_expect(status_one is Label and status_one.visible, "任务折叠后状态仍必须显示")
+
+	screen.queue_free()
+	if _errors.is_empty():
+		print("PASS: production task editors own independent scripts, providers and models")
+		get_tree().quit(0)
+		return
+	for message in _errors:
+		push_error(message)
+	get_tree().quit(1)
+
+
+func _expect(condition: bool, message: String) -> void:
+	if not condition:
+		_errors.append(message)
