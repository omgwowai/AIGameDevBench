@@ -0,0 +1,442 @@
+extends VBoxContainer
+class_name StoryboardEditor
+
+# Reusable editable storyboard (分镜) widget. Extracted from ScriptGen so VideoGen can show
+# and edit the same two-level shot structure instead of a flat text prompt.
+#
+# Structure (identical to what ScriptGen produces / consumes):
+#   { scene:{time,place,background}, characters,
+#     shots:[ { <main fields…>, duration, subshots:[{code,period,camera,camera_move,script}] } ] }
+# Legacy flat shots {period,purpose,description,script,duration} are normalized on load.
+#
+# Usage:
+#   var ed := StoryboardEditor.new()
+#   host.add_child(ed)
+#   ed.load_storyboard(sb)            # fill from a dict
+#   var sb := ed.collect_storyboard() # read back the edited dict
+#   ed.changed.connect(func(): ...)   # fires on any edit (host shows update/save buttons)
+#
+# Signals `changed` on any text/spin edit or row add/remove, so a host can reveal
+# "更新现有 / 另存为新" only after the user actually edits (VideoGen keeps them always-on, but
+# the signal is available either way).
+
+signal changed
+
+const MAIN_SHOT_FIELDS := [
+	["period", "时段/镜头号"], ["shot_size", "景别"], ["characters", "镜头人物"],
+	["frame", "画面/调度"], ["emotion", "情绪"], ["sound", "声音"],
+	["lighting", "灯光/色彩"], ["art", "美术/服化"], ["lens", "镜头焦段"], ["intent", "导演意图"],
+]
+const MAIN_SHOT_MULTILINE := ["frame"]
+
+var scene_time_edit: LineEdit
+var scene_place_edit: LineEdit
+var scene_background_edit: TextEdit
+var scene_characters_edit: TextEdit
+var shots_box: VBoxContainer
+var _shot_rows: Array = []
+
+
+func _ready() -> void:
+	add_theme_constant_override("separation", 8)
+	_build_ui()
+
+
+func _build_ui() -> void:
+	# 场景设定
+	var scene_cap := Label.new()
+	scene_cap.text = "场景设定"
+	scene_cap.add_theme_font_size_override("font_size", 13)
+	add_child(scene_cap)
+
+	var grid := GridContainer.new()
+	grid.columns = 2
+	grid.add_theme_constant_override("h_separation", 8)
+	grid.add_theme_constant_override("v_separation", 4)
+	grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	add_child(grid)
+
+	grid.add_child(_field_label("时间"))
+	scene_time_edit = LineEdit.new()
+	scene_time_edit.placeholder_text = "如：清晨 / 第一天黄昏"
+	scene_time_edit.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	scene_time_edit.text_changed.connect(func(_t): changed.emit())
+	grid.add_child(scene_time_edit)
+
+	grid.add_child(_field_label("地点"))
+	scene_place_edit = LineEdit.new()
+	scene_place_edit.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	scene_place_edit.text_changed.connect(func(_t): changed.emit())
+	grid.add_child(scene_place_edit)
+
+	grid.add_child(_field_label("背景"))
+	scene_background_edit = TextEdit.new()
+	scene_background_edit.wrap_mode = TextEdit.LINE_WRAPPING_BOUNDARY
+	scene_background_edit.custom_minimum_size = Vector2(0, 44)
+	scene_background_edit.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	scene_background_edit.text_changed.connect(func(): changed.emit())
+	grid.add_child(scene_background_edit)
+
+	grid.add_child(_field_label("人物"))
+	scene_characters_edit = TextEdit.new()
+	scene_characters_edit.wrap_mode = TextEdit.LINE_WRAPPING_BOUNDARY
+	scene_characters_edit.custom_minimum_size = Vector2(0, 44)
+	scene_characters_edit.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	scene_characters_edit.text_changed.connect(func(): changed.emit())
+	grid.add_child(scene_characters_edit)
+
+	# 分镜列表
+	var shots_head := HBoxContainer.new()
+	add_child(shots_head)
+	var shots_cap := Label.new()
+	shots_cap.text = "分镜"
+	shots_cap.add_theme_font_size_override("font_size", 13)
+	shots_cap.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	shots_head.add_child(shots_cap)
+	var add_shot := Button.new()
+	add_shot.text = "+ 添加镜头"
