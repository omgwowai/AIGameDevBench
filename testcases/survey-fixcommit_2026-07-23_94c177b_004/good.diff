+# Like popup_pick but multi-select: confirm passes ALL selected records (in list/selection
+# order) to `on_pick_many.call(records: Array)`. Used e.g. to batch-add clips for concat.
+static func popup_pick_multi(host: Node, kind: String, on_pick_many: Callable) -> void:
+	var items: Array = list_all(kind)
+	var dialog := AcceptDialog.new()
+	dialog.title = "从素材库多选（%s）" % kind
+	dialog.min_size = Vector2i(460, 360)
+
+	var box := VBoxContainer.new()
+	box.custom_minimum_size = Vector2(440, 320)
+	dialog.add_child(box)
+
+	if items.is_empty():
+		var empty := Label.new()
+		empty.text = "库中没有 %s 类型的条目。" % kind
+		box.add_child(empty)
+		host.add_child(dialog)
+		dialog.close_requested.connect(dialog.queue_free)
+		dialog.confirmed.connect(dialog.queue_free)
+		dialog.popup_centered()
+		return
+
+	var hint := Label.new()
+	hint.text = "按住 Ctrl/Shift 多选，确定后按选中顺序拼接。"
+	hint.add_theme_font_size_override("font_size", 12)
+	box.add_child(hint)
+
+	var list := ItemList.new()
+	list.select_mode = ItemList.SELECT_MULTI
+	list.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	list.size_flags_vertical = Control.SIZE_EXPAND_FILL
+	for rec in items:
+		list.add_item(label_for(rec))
+	box.add_child(list)
+
+	dialog.confirmed.connect(func():
+		var sel: PackedInt32Array = list.get_selected_items()
+		var chosen: Array = []
+		for i in sel:          # get_selected_items() returns indices in ascending (list) order
+			chosen.append(items[i])
+		if not chosen.is_empty():
+			on_pick_many.call(chosen)
+		dialog.queue_free()
+	)
+	dialog.close_requested.connect(dialog.queue_free)
+
+	host.add_child(dialog)
+	dialog.popup_centered()
