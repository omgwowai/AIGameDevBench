+	shots_box = VBoxContainer.new()
+	shots_box.add_theme_constant_override("separation", 8)
+	shots_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	add_child(shots_box)
+
+
+# --- shot rows --------------------------------------------------------------
+
+func _add_shot_row(values: Dictionary = {}) -> void:
+	var box := PanelContainer.new()
+	box.add_theme_stylebox_override("panel", Palette.card(Palette.BG_RAISED, Palette.HAIRLINE))
