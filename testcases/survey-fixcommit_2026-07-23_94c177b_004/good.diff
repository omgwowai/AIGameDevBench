+extends Control
+
+# Step 4 container. Each accordion body is a complete, independent VideoGen editor
+# instance; editors share only the persistent GenerationService coordinator.
+
+const VideoTaskEditorScript := preload("res://scripts/screens/video_gen.gd")
+const StepNavScript := preload("res://scripts/ui/step_nav.gd")
+
+var _task_list: VBoxContainer
+var _editors: Dictionary = {}  # editor_id -> UI refs
+var _serial: int = 0
+
+
+func _ready() -> void:
+	_build_ui()
+	_restore_editors_from_service()
+
+
+# Rebuild one accordion editor per editor_id that has EITHER a still-living GenerationService
+# task OR a saved draft, so leaving and returning to this page keeps both in-flight/finished
+# tasks AND unsubmitted drafts (inputs refilled by the editor's own _restore_state). Falls
+# back to a single blank editor when there's nothing to restore.
+func _restore_editors_from_service() -> void:
+	var seen: Dictionary = {}          # editor_id -> display name (task name wins over draft)
+	var order: Array = []              # preserve submission / draft order
+	var max_serial: int = 0
+	var note_id := func(eid: String, name: String):
+		if eid.is_empty():
+			return
+		if not seen.has(eid):
+			order.append(eid)
+		# Task name (non-empty) takes precedence over a draft's name.
+		if not seen.has(eid) or (seen.get(eid, "") == "" and name != ""):
+			seen[eid] = name
+		var suffix: String = eid.get_slice("_", eid.get_slice_count("_") - 1)
+		if suffix.is_valid_int():
+			max_serial = maxi(max_serial, int(suffix))
+
+	# Live tasks first (they own the results), then draft-only editors.
+	for raw_task in GenerationService.get_tasks():
+		var task: Dictionary = raw_task if typeof(raw_task) == TYPE_DICTIONARY else {}
+		var details: Dictionary = task.get("details", {}) if typeof(task.get("details", {})) == TYPE_DICTIONARY else {}
+		note_id.call(str(details.get("editor_id", "")), str(task.get("name", "")))
+	for key in AppState.scene_keys("videoGen/draft/"):
+		var eid: String = str(key).substr("videoGen/draft/".length())
+		var draft: Dictionary = AppState.get_scene(key)
+		note_id.call(eid, str(draft.get("task_name", "")))
+
+	_serial = max_serial
+	for eid in order:
+		_add_task_editor(eid, str(seen[eid]))
+	if _editors.is_empty():
+		_add_task_editor()
+
+
+func _build_ui() -> void:
+	set_anchors_preset(Control.PRESET_FULL_RECT)
+	var background := ColorRect.new()
+	background.color = Palette.BG
+	background.set_anchors_preset(Control.PRESET_FULL_RECT)
+	add_child(background)
+
+	# Same layout as the other steps (editGen/profileEditor): an HBox with the nav as a
+	# real first column, then the content. This avoids the floating-anchor overlay that
+	# both swallowed nav clicks and visually overlapped the task tabs.
+	var root := HBoxContainer.new()
+	root.set_anchors_preset(Control.PRESET_FULL_RECT)
+	add_child(root)
+
+	var nav := StepNavScript.new()
+	nav.current_step = 4
+	nav.size_flags_vertical = Control.SIZE_EXPAND_FILL
+	root.add_child(nav)
+
+	var margin := MarginContainer.new()
+	margin.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	margin.size_flags_vertical = Control.SIZE_EXPAND_FILL
+	margin.add_theme_constant_override("margin_left", 16)
+	margin.add_theme_constant_override("margin_top", 18)
+	margin.add_theme_constant_override("margin_right", 18)
+	margin.add_theme_constant_override("margin_bottom", 18)
+	root.add_child(margin)
+
+	var root_box := VBoxContainer.new()
+	root_box.add_theme_constant_override("separation", 10)
+	margin.add_child(root_box)
+
+	var top := HBoxContainer.new()
+	top.add_theme_constant_override("separation", 10)
+	root_box.add_child(top)
+	var title := Label.new()
+	title.text = "视频生产任务"
+	title.add_theme_font_size_override("font_size", 22)
+	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	top.add_child(title)
+	var add_button := Button.new()
+	add_button.name = "AddProductionTaskTabButton"
+	add_button.text = "+ 新增生产任务"
+	add_button.custom_minimum_size = Vector2(160, 40)
+	add_button.pressed.connect(_add_task_editor)
+	top.add_child(add_button)
+
+	var hint := Label.new()
+	hint.text = "每个任务拥有独立的脚本、模型、参数与参考素材；可分别启动并行生成。折叠后仍显示执行状态和耗时。"
+	hint.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	hint.add_theme_font_size_override("font_size", 11)
+	root_box.add_child(hint)
+
+	var scroll := ScrollContainer.new()
+	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
+	scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
+	root_box.add_child(scroll)
+
+	_task_list = VBoxContainer.new()
+	_task_list.name = "ProductionTaskTabList"
+	_task_list.add_theme_constant_override("separation", 10)
+	_task_list.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	scroll.add_child(_task_list)
+
+
+# Adds one accordion editor. When restore_id is given the editor reuses that id (so it
+# re-binds to its still-living GenerationService task); otherwise a new id is minted.
+func _add_task_editor(restore_id: String = "", restore_name: String = "") -> void:
+	var editor_id: String
+	var serial: int
+	if restore_id.is_empty():
+		_serial += 1
+		serial = _serial
+		editor_id = "production_task_%d" % serial
+	else:
+		editor_id = restore_id
+		var suffix: String = restore_id.get_slice("_", restore_id.get_slice_count("_") - 1)
+		serial = int(suffix) if suffix.is_valid_int() else _serial
+	var default_name: String = restore_name.strip_edges() if not restore_name.strip_edges().is_empty() else "视频任务_%02d" % serial
+	var panel := PanelContainer.new()
+	panel.name = "ProductionTaskPanel_%d" % serial
+	panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	panel.add_theme_stylebox_override("panel", _panel_style())
+	_task_list.add_child(panel)
+
+	var box := VBoxContainer.new()
+	box.add_theme_constant_override("separation", 6)
+	panel.add_child(box)
+	var header := HBoxContainer.new()
+	header.add_theme_constant_override("separation", 8)
+	box.add_child(header)
+
+	var toggle := Button.new()
+	toggle.name = "ProductionTaskToggle_%d" % serial
+	toggle.toggle_mode = true
+	toggle.button_pressed = true
+	toggle.text = "▼ " + default_name
+	toggle.alignment = HORIZONTAL_ALIGNMENT_LEFT
+	toggle.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	header.add_child(toggle)
+
+	var status := Label.new()
+	status.name = "ProductionTaskStatus_%d" % serial
+	status.text = "待配置"
+	status.custom_minimum_size = Vector2(260, 0)
+	status.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
+	status.tooltip_text = "即使折叠任务内容，这里也会持续显示执行状态。"
+	header.add_child(status)
+
+	var abort := Button.new()
+	abort.text = "中止"
+	abort.disabled = true
+	header.add_child(abort)
+	var remove := Button.new()
+	remove.text = "删除"
+	header.add_child(remove)
+
+	var content := VBoxContainer.new()
+	content.name = "ProductionTaskContent_%d" % serial
+	content.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	box.add_child(content)
+
+	var editor = VideoTaskEditorScript.new()
+	editor.name = "VideoTaskEditor_%d" % serial
+	editor.embedded_task_mode = true
+	editor.editor_instance_id = editor_id
+	editor.embedded_task_status_changed.connect(_on_editor_status_changed)
+	editor.embedded_task_name_changed.connect(_on_editor_name_changed)
+	_editors[editor_id] = {
+		"editor": editor,
+		"panel": panel,
+		"toggle": toggle,
+		"content": content,
+		"status": status,
+		"abort": abort,
+		"remove": remove,
+		"name": default_name,
+		"active": false,
+	}
+	toggle.toggled.connect(_on_toggle_task.bind(editor_id))
+	abort.pressed.connect(_on_abort_task.bind(editor_id))
+	remove.pressed.connect(_on_remove_task.bind(editor_id))
+	# Register the outer header before the editor enters the tree so its initial status/name
+	# signals are not lost during _ready().
+	content.add_child(editor)
+	# For a brand-new tab, seed the default name. For a restored tab, the editor's own
+	# _restore_state already refilled task_name (and all other inputs) from its draft, so
+	# only fill in when it came back empty — don't clobber the restored value.
+	if editor.task_name_edit != null:
+		if restore_id.is_empty() or editor.task_name_edit.text.strip_edges().is_empty():
+			editor.task_name_edit.text = default_name
+
+
+func _on_toggle_task(expanded: bool, editor_id: String) -> void:
+	if not _editors.has(editor_id):
+		return
+	var item: Dictionary = _editors[editor_id]
+	item["content"].visible = expanded
+	item["toggle"].text = ("▼ " if expanded else "▶ ") + str(item.get("name", "生产任务"))
+
+
+func _on_editor_name_changed(editor_id: String, task_name: String) -> void:
+	if not _editors.has(editor_id):
+		return
+	var item: Dictionary = _editors[editor_id]
+	var clean: String = task_name.strip_edges()
+	item["name"] = clean if not clean.is_empty() else "生产任务"
+	item["toggle"].text = ("▼ " if item["toggle"].button_pressed else "▶ ") + str(item["name"])
+	_editors[editor_id] = item
+
+
+func _on_editor_status_changed(editor_id: String, task_status: String, active: bool, elapsed_seconds: float) -> void:
+	if not _editors.has(editor_id):
+		return
+	var item: Dictionary = _editors[editor_id]
+	item["active"] = active
+	item["status"].text = "%s · %.0fs" % [task_status, elapsed_seconds]
+	item["abort"].disabled = not active
+	item["remove"].disabled = active
+	_editors[editor_id] = item
+
+
+func _on_abort_task(editor_id: String) -> void:
+	if _editors.has(editor_id):
+		_editors[editor_id]["editor"].call("_on_abort_pressed")
+
+
+func _on_remove_task(editor_id: String) -> void:
+	if not _editors.has(editor_id):
+		return
+	var item: Dictionary = _editors[editor_id]
+	if bool(item.get("active", false)):
+		return
+	var panel: Control = item["panel"]
+	_editors.erase(editor_id)
+	_task_list.remove_child(panel)
+	panel.queue_free()
+
+
+func _panel_style() -> StyleBoxFlat:
+	var style := StyleBoxFlat.new()
+	style.bg_color = Palette.BG_ELEVATED
+	style.border_color = Palette.HAIRLINE
+	style.set_border_width_all(1)
+	style.set_corner_radius_all(7)
+	style.content_margin_left = 8
+	style.content_margin_right = 8
+	style.content_margin_top = 8
+	style.content_margin_bottom = 8
+	return style
