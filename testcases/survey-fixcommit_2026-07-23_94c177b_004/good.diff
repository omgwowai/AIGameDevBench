+	subs_cap.add_theme_font_size_override("font_size", 12)
+	subs_cap.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	subs_header.add_child(subs_cap)
+
+	var subs_box := VBoxContainer.new()
+	subs_box.add_theme_constant_override("separation", 4)
+	subs_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	col.add_child(subs_box)
