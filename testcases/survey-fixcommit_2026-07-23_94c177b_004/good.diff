+# @mention helpers -------------------------------------------------------------
+# The reference "名称(@)" is only a soft anchor: images and prompt text travel to the
+# model on separate channels, so an "@名称" in the prompt is just literal text the model
+# has to match against an unlabeled image. To make the match reliable we (1) append an
+# explicit ordered manifest tying each reference position to its name, and (2) validate
+# that every "@名称" typed in the prompt actually resolves to a named reference.
+
+# Ordered manifest tying each named reference to its position, e.g.
+# "【参考素材】\n第1张(image)=@角色1；第2张(image)=@小明". Empty when no refs are named.
+func _compose_reference_manifest(refs: Array) -> String:
+	var lines: Array = []
+	var idx: int = 0
+	for r in refs:
+		idx += 1
+		if str(r.get("url", "")).strip_edges().is_empty():
+			continue
+		var name: String = str(r.get("name", "")).strip_edges()
+		if name.is_empty():
+			continue
+		if not name.begins_with("@"):
+			name = "@" + name
+		var kind: String = str(r.get("type", "image")).strip_edges()
+		lines.append("第%d张(%s)=%s" % [idx, kind, name])
+	if lines.is_empty():
+		return ""
+	return "【参考素材】\n" + "；".join(lines)
+
+
+# Reference names normalized to their bare "@名称" form (dedup, non-empty only).
+func _reference_mention_names(refs: Array) -> Array:
+	var names: Array = []
+	for r in refs:
+		var name: String = str(r.get("name", "")).strip_edges()
+		if name.is_empty():
+			continue
+		name = name.substr(1) if name.begins_with("@") else name
+		if not name.is_empty() and not names.has(name):
+			names.append(name)
+	return names
+
+
+# @名称 tokens in `prompt` that don't resolve to any named reference. Matches @ followed by
+# letters/digits/underscore/CJK; a token counts as known when a reference name is a prefix
+# of it (so "@角色1的衣服" resolves via "@角色1"), avoiding false positives on trailing text.
+func _find_unknown_mentions(prompt: String, refs: Array) -> Array:
+	var known: Array = _reference_mention_names(refs)
+	var regex := RegEx.new()
+	regex.compile("@([\\w\\x{4e00}-\\x{9fff}]+)")
+	var unknown: Array = []
+	for m in regex.search_all(prompt):
+		var token: String = m.get_string(1)
+		var matched: bool = false
+		for k in known:
+			if token == k or token.begins_with(k):
+				matched = true
+				break
+		if not matched and not unknown.has(token):
+			unknown.append(token)
+	return unknown
+
