diff --git a/tests/video_tasks_persist_ui_test.gd b/tests/video_tasks_persist_ui_test.gd
new file mode 100644
index 0000000..8604e8c
--- /dev/null
+++ b/tests/video_tasks_persist_ui_test.gd
@@ -0,0 +1,96 @@
+extends Node
+
+# Verifies that re-entering the video-tasks page (a fresh screen instance) rebuilds its
+# accordion editors from the persistent GenerationService instead of clearing tasks.
+
+const VideoTasksScreenScript := preload("res://scripts/screens/video_tasks_screen.gd")
+
+var _errors: Array[String] = []
+
+
+func _ready() -> void:
+	await get_tree().process_frame
+	await _run()
+	_finish()
+
+
+func _run() -> void:
+	# Simulate a task submitted by a previous visit to the page: inject a snapshot directly
+	# into the autoload's task store, stamped with an editor_id (as real submissions are).
+	var svc = get_tree().root.get_node("GenerationService")
+	var editor_id := "production_task_1"
+	svc._tasks[editor_id] = {
+		"id": editor_id,
+		"worker": null,
+		"name": "被保留的任务",
+		"provider_label": "Seedance 2.0",
+		"kind": "batch",
+		"status": "生成中…",
+		"active": true,
+		"started_msec": Time.get_ticks_msec(),
+		"created_at": "2026-07-22 09:00:00",
+		"rows": [],
+		"details": {"editor_id": editor_id, "script_prompt": "一段脚本"},
+	}
+	svc._task_order.append(editor_id)
+
+	# Simulate a SECOND tab that was only a draft (typed but never submitted): a saved draft
+	# under its per-instance key, with no matching service task.
+	var draft_id := "production_task_2"
+	AppState.set_scene("videoGen/draft/%s" % draft_id, {
+		"task_name": "草稿任务",
+		"storyboard": {"scene": {}, "shots": [{"frame": "未提交的脚本内容", "duration": 5}]},
+		"video_setting_prompt": "电影感、暖色调",
+	})
+
+	# Fresh screen instance = what change_scene_to_file produces on re-entry.
+	var screen = VideoTasksScreenScript.new()
+	get_tree().root.add_child(screen)
+	await get_tree().process_frame
+	await get_tree().process_frame
+
+	var editors: Dictionary = screen.get("_editors")
+	_expect(editors.has(editor_id), "重新进入视频页必须按已有任务的 editor_id 重建编辑器")
+	if editors.has(editor_id):
+		var editor = editors[editor_id]["editor"]
+		_expect(
+			str(editor.get("service_task_id")) == editor_id,
+			"重建的编辑器必须重新绑定到仍存活的 GenerationService 任务",
+		)
+		_expect(
+			str(editors[editor_id].get("name", "")) == "被保留的任务",
+			"重建时必须沿用任务名称",
+		)
+
+	# Draft-only tab must be restored AND have its inputs refilled.
+	_expect(editors.has(draft_id), "只有草稿（未提交）的任务 Tab 也必须在重进后保留")
+	if editors.has(draft_id):
+		var draft_editor = editors[draft_id]["editor"]
+		var setting_edit = draft_editor.get("video_setting_edit")
+		var name_edit = draft_editor.get("task_name_edit")
+		var script_text: String = str(draft_editor.call("_script_text"))
+		_expect(script_text.contains("未提交的脚本内容"), "草稿的分镜内容必须自动回填")
+		_expect(setting_edit != null and setting_edit.text == "电影感、暖色调", "草稿的视频设定必须自动回填")
+		_expect(name_edit != null and name_edit.text == "草稿任务", "草稿的任务名称必须自动回填")
+
+	# Cleanup so injected state doesn't leak into other tests sharing the autoloads.
+	screen.queue_free()
+	svc._tasks.erase(editor_id)
+	svc._task_order.erase(editor_id)
+	AppState.clear_scene("videoGen/draft/%s" % draft_id)
+	await get_tree().process_frame
+
+
+func _expect(condition: bool, message: String) -> void:
+	if not condition:
+		_errors.append(message)
+
+
+func _finish() -> void:
+	if _errors.is_empty():
+		print("PASS: 视频页重进后从持久服务重建任务，不清空已有任务")
+		get_tree().quit(0)
+		return
+	for message in _errors:
+		push_error(message)
+	get_tree().quit(1)
