diff --git a/scripts/ui/palette.gd b/scripts/ui/palette.gd
new file mode 100644
index 0000000..bcbe3ea
--- /dev/null
+++ b/scripts/ui/palette.gd
@@ -0,0 +1,67 @@
+extends RefCounted
+class_name Palette
+
+# Single source of truth for the app's Apple-style dark palette. Every screen references
+# these constants (instead of inline Color(...) literals) so the whole UI re-skins from one
+# place. Pairs with res://theme/default_theme.tres, which styles the default control look;
+# this script covers the per-screen backgrounds, card panels, and semantic status colors
+# that the theme can't express (screens build StyleBoxes at runtime).
+#
+# Tone: iOS/macOS dark mode — neutral graphite layers, hairline borders, systemBlue accent,
+# semantic green/orange/red for status.
+
+# --- Background layers (darkest → lightest) ---
+const BG := Color(0.110, 0.110, 0.118)          # #1C1C1E — root background
+const SIDEBAR := Color(0.086, 0.086, 0.094)     # #161618 — StepNav / left rail
+const BG_ELEVATED := Color(0.173, 0.173, 0.180) # #2C2C2E — cards / panels
+const BG_RAISED := Color(0.227, 0.227, 0.235)   # #3A3A3C — raised blocks inside cards
+
+# --- Borders / separators (white at low alpha = true hairline) ---
+const HAIRLINE := Color(1, 1, 1, 0.09)
+const HAIRLINE_STRONG := Color(1, 1, 1, 0.14)
+
+# --- Text ---
+const TEXT := Color(0.961, 0.961, 0.969)             # #F5F5F7 — primary
+const TEXT_SECONDARY := Color(0.922, 0.922, 0.961, 0.60)  # secondary (labels/hints)
+const TEXT_TERTIARY := Color(0.922, 0.922, 0.961, 0.30)   # tertiary (placeholders)
+
+# --- Accent + semantic (iOS system colors, dark variants) ---
+const ACCENT := Color(0.039, 0.518, 1.0)     # #0A84FF systemBlue
+const SUCCESS := Color(0.188, 0.820, 0.345)  # #30D158 systemGreen
+const WARNING := Color(1.0, 0.624, 0.039)    # #FF9F0A systemOrange
+const DANGER := Color(1.0, 0.271, 0.227)     # #FF453A systemRed
+
+# --- Radii ---
+const RADIUS_CONTROL := 10
+const RADIUS_CARD := 14
+
+
+# Card / panel StyleBox. Defaults match the standard elevated card; callers pass a specific
+# bg (e.g. BG_RAISED, SIDEBAR) and border when they want a different layer.
+static func card(bg: Color = BG_ELEVATED, border: Color = HAIRLINE, radius: int = RADIUS_CARD) -> StyleBoxFlat:
+	var style := StyleBoxFlat.new()
+	style.bg_color = bg
+	style.border_color = border
+	style.set_border_width_all(1)
+	style.set_corner_radius_all(radius)
+	style.content_margin_left = 12
+	style.content_margin_right = 12
+	style.content_margin_top = 10
+	style.content_margin_bottom = 10
+	return style
+
+
+# Maps a status kind to a font color. Used by status/hint labels across screens.
+#   "success" → green, "warning" → orange, "error"/"danger" → red, else → secondary text.
+static func status_color(kind: String) -> Color:
+	match kind:
+		"success", "ok":
+			return SUCCESS
+		"warning", "warn":
+			return WARNING
+		"error", "danger", "fail":
+			return DANGER
+		"accent", "link":
+			return ACCENT
+		_:
+			return TEXT_SECONDARY
