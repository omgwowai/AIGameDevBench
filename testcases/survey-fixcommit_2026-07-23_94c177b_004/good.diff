+# --- URL download -----------------------------------------------------------
+
+func _on_download_pressed() -> void:
+	var url: String = url_edit.text.strip_edges()
+	if url.is_empty():
+		status_label.text = "请先粘贴视频直链。"
+		return
+	if not (url.begins_with("http://") or url.begins_with("https://")):
+		status_label.text = "只支持 http/https 直链下载。"
+		return
+	if _download_request != null and _download_request.get_http_client_status() != HTTPClient.STATUS_DISCONNECTED:
+		status_label.text = "已有下载进行中，请稍候。"
+		return
+
+	# Derive a filename+ext from the URL (before any query string); default to .mp4.
+	var clean: String = url.split("?")[0]
+	var ext: String = clean.get_extension().to_lower()
+	if ext.is_empty() or ext.length() > 5:
+		ext = "mp4"
+	var base: String = _sanitize_filename(clean.get_file().get_basename())
+	if base.is_empty():
+		base = "download"
+	var dir_abs: String = ProjectSettings.globalize_path(DOWNLOAD_DIR)
+	DirAccess.make_dir_recursive_absolute(dir_abs)
+	_download_target = dir_abs.path_join("%s.%s" % [base, ext])
+
+	if _download_request == null:
+		_download_request = HTTPRequest.new()
+		add_child(_download_request)
+		_download_request.request_completed.connect(_on_download_completed)
+	_download_request.download_file = _download_target
+	_download_request.timeout = 120
+	_download_request.cancel_request()
+	var err: Error = _download_request.request(url)
+	if err != OK:
+		status_label.text = "下载发起失败：%s" % error_string(err)
+		return
+	download_btn.disabled = true
+	status_label.text = "正在下载视频…（%s）" % url
+
+
+func _on_download_completed(result: int, response_code: int, _headers: PackedStringArray, _body: PackedByteArray) -> void:
+	download_btn.disabled = false
+	if result != HTTPRequest.RESULT_SUCCESS:
+		status_label.text = "下载失败（网络错误 %d）。" % result
+		return
+	if response_code < 200 or response_code >= 300:
+		status_label.text = "下载失败：HTTP %d。" % response_code
+		return
+	if not FileAccess.file_exists(_download_target):
+		status_label.text = "下载完成但未找到文件。"
+		return
+	status_label.text = "下载完成，正在读取…"
+	_set_video(_download_target)
+
+
+func _sanitize_filename(value: String) -> String:
+	var safe: String = value
+	for character in ["\\", "/", ":", "*", "?", "\"", "<", ">", "|", " "]:
+		safe = safe.replace(character, "_")
+	return safe.substr(0, 60)
+
+
+func _set_video(path: String) -> void:
+	_video_path = path
+	_video_duration = FfmpegUtil.probe_duration(path)
+	var res: Vector2i = FfmpegUtil.probe_resolution(path)
+	var dur_txt: String = ("%.1fs" % _video_duration) if _video_duration > 0.0 else "未知时长"
+	var res_txt: String = ("%dx%d" % [res.x, res.y]) if res.x > 0 else "未知分辨率"
+	video_info_label.text = "%s\n%s · %s" % [path.get_file(), dur_txt, res_txt]
+	if name_edit.text.strip_edges().is_empty():
+		name_edit.text = path.get_file().get_basename()
+	_update_thumb(path)
+	status_label.text = "已载入视频，可点击生成。"
+
+
+func _update_thumb(path: String) -> void:
+	var ffmpeg: String = FfmpegUtil.resolve()
+	if ffmpeg.is_empty():
+		return
+	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(FRAMES_DIR))
+	var thumb_abs: String = ProjectSettings.globalize_path(FRAMES_DIR.path_join("thumb.jpg"))
+	var src_abs: String = ProjectSettings.globalize_path(path) if path.begins_with("res://") or path.begins_with("user://") else path
+	if FfmpegUtil.extract_thumbnail(ffmpeg, src_abs, thumb_abs, 320) == 0 and FileAccess.file_exists(thumb_abs):
+		var img := Image.new()
+		if img.load(thumb_abs) == OK:
+			thumb_rect.texture = ImageTexture.create_from_image(img)
+
