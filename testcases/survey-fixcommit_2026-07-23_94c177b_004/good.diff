+
+
+func _add_subshot_row(shot: Dictionary, values: Dictionary = {}) -> void:
+	var subs_box: VBoxContainer = shot.get("subs_box")
+	if subs_box == null or not is_instance_valid(subs_box):
+		return
+	var row := VBoxContainer.new()
+	row.add_theme_constant_override("separation", 2)
+	subs_box.add_child(row)
+
+	var top := HBoxContainer.new()
