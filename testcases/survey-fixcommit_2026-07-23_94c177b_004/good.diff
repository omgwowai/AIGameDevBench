+	subs_header.add_child(add_sub_btn)
+
+	_shot_rows.append(entry)
+	remove.pressed.connect(_on_remove_shot.bind(entry))
+
+	var subs: Array = values.get("subshots", []) if typeof(values.get("subshots", [])) == TYPE_ARRAY else []
+	for sv in subs:
+		if typeof(sv) == TYPE_DICTIONARY:
+			_add_subshot_row(entry, sv)
