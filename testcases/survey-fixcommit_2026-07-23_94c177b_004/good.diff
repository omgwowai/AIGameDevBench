+	duration.value_changed.connect(func(_v): changed.emit())
+	head.add_child(duration)
+	var remove := Button.new()
+	remove.text = "删除镜头"
+	head.add_child(remove)
+
+	var grid := GridContainer.new()
+	grid.columns = 2
+	grid.add_theme_constant_override("h_separation", 8)
+	grid.add_theme_constant_override("v_separation", 4)
+	grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	col.add_child(grid)
+	var fields: Dictionary = {}
+	for pair in MAIN_SHOT_FIELDS:
+		var key: String = pair[0]
+		grid.add_child(_field_label(pair[1]))
+		var ctrl: Control
+		if key in MAIN_SHOT_MULTILINE:
+			var te := TextEdit.new()
+			te.wrap_mode = TextEdit.LINE_WRAPPING_BOUNDARY
+			te.custom_minimum_size = Vector2(0, 44)
+			te.text = str(values.get(key, ""))
+			te.text_changed.connect(func(): changed.emit())
+			ctrl = te
+		else:
+			var le := LineEdit.new()
