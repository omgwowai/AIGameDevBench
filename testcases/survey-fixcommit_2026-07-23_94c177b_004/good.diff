index 0000000..4f9bc8c
--- /dev/null
+++ b/tests/video_parallel_tasks_test.gd
@@ -0,0 +1,86 @@
+extends SceneTree
+
+const GenerationServiceScript := preload("res://scripts/core/generation_service.gd")
+
+var _errors: Array[String] = []
+
+
+class FakeWorker extends Node:
+	signal job_started(kind: String, rows: Array)
+	signal row_updated(index: int, row: Dictionary)
+	signal job_finished(status_text: String)
+	signal preview(godot_path: String, display_path: String)
+
+	var rows: Array = []
+	var active: bool = false
+	var status_text: String = "等待"
+	var generation_task_id: String = ""
+	var generation_task_name: String = ""
+
+	func begin(label: String) -> void:
+		active = true
+		status_text = "生成中…"
+		rows = [{
+			"label": label, "status": "生成中", "text": "%s — 生成中" % label,
+			"finished": false, "godot_path": "", "display_path": "",
+			"started_msec": Time.get_ticks_msec(),
+		}]
+		job_started.emit("batch", rows)
+
+	func finish_ok() -> void:
+		active = false
+		status_text = "完成"
+		rows[0]["status"] = "成功"
+		rows[0]["text"] = "%s — 成功" % rows[0]["label"]
+		rows[0]["finished"] = true
+		row_updated.emit(0, rows[0])
+		job_finished.emit(status_text)
+
+	func abort() -> void:
+		active = false
+		status_text = "已中止生成。"
+		for row in rows:
+			row["finished"] = true
+			row["status"] = "已中止"
+		job_finished.emit(status_text)
+
+	func get_rows() -> Array:
+		return rows
+
+
+func _initialize() -> void:
+	var manager = GenerationServiceScript.new()
+	root.add_child(manager)
+
+	var first := FakeWorker.new()
+	var second := FakeWorker.new()
+	var first_id: String = manager.call("_register_task_worker", first, "任务一", "Provider A", "Prompt A", "batch", {"params": {"duration": 5}})
+	var second_id: String = manager.call("_register_task_worker", second, "任务二", "Provider B", "Prompt B", "chain", {"params": {"duration": 20}})
+	first.begin("模型 A")
+	second.begin("模型 B")
+
+	_expect(first_id != second_id, "并行任务必须拥有独立 ID")
+	_expect(manager.active_task_count() == 2, "两个已启动任务必须同时保持 active")
+	_expect(manager.get_tasks().size() == 2, "任务协调器必须同时保留两个 Task Tab 快照")
+	_expect(str(manager.get_task(first_id).get("details", {}).get("params", {}).get("duration", 0)) == "5", "任务必须保留独立参数快照")
+
+	first.finish_ok()
+	_expect(manager.active_task_count() == 1, "一个任务结束不得影响另一个运行中的任务")
+	_expect(bool(manager.get_task(second_id).get("active", false)), "第二个任务必须继续运行")
+
+	_expect(manager.abort_task(second_id), "必须支持单独中止指定任务")
+	_expect(manager.active_task_count() == 0, "单项中止后不应残留活动任务")
+
+	manager.queue_free()
+	if _errors.is_empty():
+		print("PASS: video generation tasks are isolated, concurrent, foldable snapshots")
+		quit(0)
+		return
+	for message in _errors:
+		push_error(message)
+	quit(1)
+
+
+func _expect(condition: bool, message: String) -> void:
+	if not condition:
+		_errors.append(message)
