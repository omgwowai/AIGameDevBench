diff --git a/scripts/providers/tencent_kling_client.gd b/scripts/providers/tencent_kling_client.gd
index 1e2e833..d340517 100644
--- a/scripts/providers/tencent_kling_client.gd
+++ b/scripts/providers/tencent_kling_client.gd
@@ -597,7 +597,9 @@ func _download_video(video_url: String) -> void:
