diff --git a/run.bat b/run.bat
index 1efd766..779ac30 100644
--- a/run.bat
+++ b/run.bat
@@ -1,35 +1,73 @@
 @echo off
-REM 清空 Godot 缓存并启动游戏 runtime。
-REM 切换 Godot 版本后（例如 4.7 缓存被 4.6.x 打开）务必用它清缓存，避免
-REM "Failed to load script ... Parse error / does not inherit from Node" 之类的报错。
+REM Launch the game runtime. Cache is NOT cleared by default (fast start).
+REM Cache-clear policy:
+REM   * auto on Godot version change (old cache is incompatible -> rmdir .godot)
+REM   * force manually:  run.bat clean
+REM This avoids "Failed to load script ... Parse error / does not inherit from Node"
+REM (stale-cache issues, e.g. a 4.7 cache opened by 4.6.x) without re-importing every run.
 
 setlocal enabledelayedexpansion
 cd /d "%~dp0"
 
-REM --- 1) 定位 Godot 可执行 ---
-REM 优先环境变量 GODOT；否则找 PATH 上的 godot；否则用常见安装位置。
+REM --- 1) Locate the Godot executable ---
+REM Prefer env var GODOT; else godot on PATH; else a common install location.
 set "GODOT=%GODOT%"
 if not defined GODOT (
     where godot >nul 2>&1 && set "GODOT=godot"
 )
 if not defined GODOT if exist "D:\Godot\godot\bin\godot.exe" set "GODOT=D:\Godot\godot\bin\godot.exe"
 if not defined GODOT (
-    echo 未找到 Godot 可执行文件。
-    echo 请把 godot 加入 PATH，或设置环境变量 GODOT 指向 godot.exe，例如：
+    echo Godot executable not found.
+    echo Add godot to PATH, or set env var GODOT to godot.exe, e.g.:
     echo     set GODOT=D:\Godot\godot\bin\godot.exe
     pause
     exit /b 1
 )
 
-REM --- 2) 清空缓存 ---
-if exist ".godot" (
-    echo 正在清空缓存 .godot ...
-    rmdir /s /q ".godot"
+REM --- 2) Read current Godot version (via temp file to avoid for/f quoting pitfalls) ---
+set "GODOT_VER="
+set "_VTMP=%TEMP%\_godot_ver_%RANDOM%.txt"
+"%GODOT%" --headless --version > "%_VTMP%" 2>nul
+if exist "%_VTMP%" (
+    for /f "usebackq delims=" %%v in ("%_VTMP%") do if not defined GODOT_VER set "GODOT_VER=%%v"
+    del "%_VTMP%" >nul 2>&1
 )
 
-REM --- 3) 启动游戏 runtime（直接跑主场景，不进编辑器）---
-echo 使用 Godot: %GODOT%
-echo 启动游戏 runtime ...
+REM --- 3) Decide whether to clear the cache ---
+set "DO_CLEAN="
+set "VERFILE=.godot\.godot_version"
+if /i "%~1"=="clean" set "DO_CLEAN=1"
+if not defined DO_CLEAN (
+    if exist "%VERFILE%" (
+        set "LAST_VER="
+        for /f "usebackq delims=" %%v in ("%VERFILE%") do set "LAST_VER=%%v"
+        if not "!LAST_VER!"=="%GODOT_VER%" (
+            echo Godot version changed: !LAST_VER!  -^>  %GODOT_VER%
+            set "DO_CLEAN=1"
+        )
+    )
+)
+
+if defined DO_CLEAN (
+    if exist ".godot" (
+        echo Clearing cache .godot ...
+        rmdir /s /q ".godot"
+    )
+)
+
+REM --- 4) Rebuild cache if missing (first run / just cleared). Pure runtime does NOT
+REM     rebuild .godot; without it, resource/script-class loading breaks, so seed it once.
+if not exist ".godot\global_script_class_cache.cfg" (
+    echo Rebuilding cache ^(import resources + register script classes^) ...
+    "%GODOT%" --headless --editor --quit >nul 2>&1
+)
+
+REM Record this version for next-run comparison (no trailing newline/space).
+if exist ".godot" ( <nul set /p "=%GODOT_VER%" > "%VERFILE%" )
+
+REM --- 5) Launch the game runtime (main scene; not the editor) ---
+echo Using Godot: %GODOT%  ^(%GODOT_VER%^)
+echo Launching game runtime ...
 "%GODOT%" --path "%~dp0."
 
 endlocal
