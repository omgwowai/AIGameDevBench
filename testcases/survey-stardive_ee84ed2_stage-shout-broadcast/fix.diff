diff --git a/scripts/components/behavior_runner.gd b/scripts/components/behavior_runner.gd
index cffa996..387232d 100644
--- a/scripts/components/behavior_runner.gd
+++ b/scripts/components/behavior_runner.gd
@@ -332,6 +332,7 @@ func _start_interaction() -> void:
 	_performance_pulse_accum = 0.0
 	_performance_tips_total = 0
 	owner_npc.velocity = Vector2.ZERO
+	_announce_performance_started()
 	_show_interaction_feedback()
 	AiDebug.log(owner_npc, "Runner", "phase INTERACTING behavior=%s duration=%.2f" % [String(current_behavior.behavior_id), interaction_time_left])
 
@@ -348,6 +349,25 @@ func _update_interaction(delta: float) -> void:
 
 	_complete_with_roll()
 
+# A show starting is an attention-grabbing world event: NPCs in earshot get
+# an interrupt-rethink (events.json performance_started_reaction) and their
+# next decision sees watch_performance as a candidate.
+func _announce_performance_started() -> void:
+	if owner_npc == null or current_behavior == null:
+		return
+	var perform_id := DataCatalog.get_gameplay_string_name("stage_performance.behavior_id", &"perform_on_stage")
+	if current_behavior.behavior_id != perform_id:
+		return
+	var performer_name := EffectApplier.get_npc_display_name(owner_npc)
+	EventBus.emit_game_event(&"performance_started", {
+		&"source": owner_npc,
+		&"actor": owner_npc,
+		&"actor_name": performer_name,
+		&"position": owner_npc.global_position,
+		&"involved_npcs": [owner_npc],
+		&"detail": "%s 登上舞台开始表演了，台下还空着，欢迎围观" % performer_name
+	})
+
 # While performing on stage: every pulse_interval_sec roll a charm check.
 # Success rewards the audience (fun/social), the performer (social), and —
 # if the LLM provided tip_speech — begs for tips with a bubble, collecting
@@ -412,6 +432,17 @@ func _beg_for_tips(audience: Array, performer_name: String) -> void:
 		return
 
 	owner_npc.show_speech_bubble(tip_speech)
+	# The shout itself is a world event — NPCs in earshot see it in their
+	# recent_events and can decide to come watch, even with zero audience yet.
+	EventBus.emit_game_event(&"performance_shout", {
+		&"source": owner_npc,
+		&"actor": owner_npc,
+		&"actor_name": performer_name,
+		&"position": owner_npc.global_position,
+		&"involved_npcs": [owner_npc],
+		&"speech": tip_speech,
+		&"detail": "%s 在舞台上一边表演一边吆喝：「%s」" % [performer_name, tip_speech.left(60)]
+	})
 	var tip_chance := DataCatalog.get_gameplay_float("stage_performance.tip_chance", 0.5)
 	var tip_amount := maxi(DataCatalog.get_gameplay_int("stage_performance.tip_amount", 1), 1)
 	var tipped := 0
