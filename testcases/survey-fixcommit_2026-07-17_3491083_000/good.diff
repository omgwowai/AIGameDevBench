diff --git a/start.bat b/start.bat
new file mode 100644
index 0000000..8388eed
--- /dev/null
+++ b/start.bat
@@ -0,0 +1,59 @@
+@echo off
+setlocal
+
+set "PROJECT_DIR=%~dp0"
+if "%PROJECT_DIR:~-1%"=="\" set "PROJECT_DIR=%PROJECT_DIR:~0,-1%"
+pushd "%PROJECT_DIR%" >nul
+
+if not exist "project.godot" (
+  echo project.godot was not found in:
+  echo %PROJECT_DIR%
+  echo.
+  pause
+  exit /b 1
+)
+
+if defined GODOT_EXE (
+  if exist "%GODOT_EXE%" goto run_project
+  echo GODOT_EXE is set, but the file does not exist:
+  echo %GODOT_EXE%
+  echo.
+)
+
+for %%G in (godot.exe godot4.exe godot4.7.exe Godot_v4.7-stable_win64.exe Godot_v4.7-stable_mono_win64.exe Godot_v4.6.3-stable_win64.exe Godot_v4.6.3-stable_mono_win64.exe) do (
+  where.exe %%G >nul 2>nul
+  if not errorlevel 1 (
+    set "GODOT_EXE=%%G"
+    goto run_project
+  )
+)
+
+for /f "delims=" %%G in ('dir /b /s "%LOCALAPPDATA%\Microsoft\WinGet\Packages\GodotEngine.GodotEngine_*\Godot*.exe" 2^>nul') do (
+  set "GODOT_EXE=%%G"
+  goto run_project
+)
+
+for /f "delims=" %%G in ('dir /b /s "%PROJECT_DIR%\..\Godot*\Godot*.exe" 2^>nul') do (
+  set "GODOT_EXE=%%G"
+  goto run_project
+)
+
+echo Godot was not found.
+echo.
+echo Set GODOT_EXE to your Godot executable, or add the Godot folder to PATH, then run it again.
+echo.
+pause
+exit /b 1
+
+:run_project
+echo Starting Avatar Video Generator...
+"%GODOT_EXE%" --path "%PROJECT_DIR%" %*
+set "EXIT_CODE=%ERRORLEVEL%"
+popd >nul
+if not "%EXIT_CODE%"=="0" (
+  echo.
+  echo Godot exited with code %EXIT_CODE%.
+  echo.
+  pause
+)
+exit /b %EXIT_CODE%
