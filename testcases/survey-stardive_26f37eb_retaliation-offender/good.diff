+# The NPC responsible for an event (attacker / thief), read from the payload's
+# actor (falling back to source). Only NPCs count; a freed reference resolves to
+# null so callers can skip the reaction safely.
+func _event_offender(payload: Dictionary) -> NPC:
+	var value = payload.get(&"actor", payload.get("actor", null))
+	if typeof(value) != TYPE_OBJECT or not is_instance_valid(value) or not (value is NPC):
+		value = payload.get(&"source", payload.get("source", null))
+	if typeof(value) == TYPE_OBJECT and is_instance_valid(value) and value is NPC:
+		return value as NPC
+	return null
+
+# True when the reaction forces a behavior whose target_query resolves to an NPC
+# (e.g. attack_npc). Such reactions require an explicit offender to aim at.
+func _reaction_forces_npc_target(reaction: EventReactionDef) -> bool:
+	if reaction == null or reaction.forced_behavior_id == &"":
+		return false
+	var behavior := DataCatalog.get_behavior(reaction.forced_behavior_id)
+	if behavior == null or behavior.target_query == null:
+		return false
+	return behavior.target_query.target_type == TargetQueryDef.TargetType.NEAREST_NPC
